#豪血寺外传 最强传说 (C) Atlus/Cave 1995
$info=plegends,plegendsj
$cmd
[ 基本操作 ]
─────────────────────────
  _7_8_9  后跳/垂直跳跃/前跳
  _4_N_6  后退&站立防御/回中/前进
  _1_2_3  下蹲&下蹲防御/下蹲/下蹲

　  _a：轻拳 (轻_P)
　  _b：轻脚 (轻_K)
　  _c：重拳 (重_P)
　  _d：重脚 (重_K)
_c_+_d：超重击(重_P_+重_K、站立/蹲下/空中均可发动)
_a_+_b：迎击防御(轻_P_+轻_K)

　_6_6：前冲
  _4_4：疾退

　前冲攻击可造成２倍伤害。

  二段跳：空中_7or_8or_9
  
  忍耐槽：受到对手攻击或发出的攻击被对手防御时，
          槽就会增加。
  
  爆发　：忍耐槽满时，角色会有爆发动作。此时全身无
          敌，放出的气流有攻击判定且可弹开敌人。

  一发奥义：忍耐槽MAX状态时可用。

  特殊必杀技：标注△的招式。表示该招在前冲中发动
              会变为加强版。
              (除“安妮”的“弦月脚”之外，其它
              原蓄力必杀技在前冲中发动也不再需要
              蓄力。如_4蓄_6_+_P只需在前冲中输入
              _4_6_+_P)
$end
$cmd
[ 指令符号说明 ] 
─────────────────────────
●：投技
○：特殊技
◎：必杀技
△：特殊必杀技
└：追打
☆：一发奥义
$end
